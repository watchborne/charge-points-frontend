NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000/ws

# Public-facing OCPP endpoint that charge points dial into (shown on the
# in-app Configuration page). Distinct from NEXT_PUBLIC_WS_URL, which is the
# dashboard's own status websocket.
NEXT_PUBLIC_OCPP_SERVER_URL=ws://localhost:9000/ocpp

# Secret key sent as the x-api-key header on every backend request.
# This value is SERVER-SIDE ONLY — do NOT add the NEXT_PUBLIC_ prefix
# or it will be exposed to the browser bundle.
API_SECRET_KEY=your-secret-api-key-here

# Supabase Auth. Both values are PUBLIC by design (the anon key is safe in the
# browser — Row Level Security governs data access), hence the NEXT_PUBLIC_
# prefix. Find them under Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# VAPID public key for Web Push subscriptions (charge-points-server issues
# #587-590). Public by design — it's meant to reach the browser, hence
# NEXT_PUBLIC_ — but there's no sensible shared default: each environment
# mints its own VAPID keypair server-side. Leaving it unset disables push
# subscribing (usePushSubscription logs and skips rather than throwing).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional, LOCAL DEV ONLY — enables the "Dev only" sign-in shortcut on
# /login (app/auth/dev-login/route.ts), which mints a magic link via the
# Supabase admin API instead of sending an email. Never set these in a
# deployed environment: the service-role key bypasses Row Level Security.
# Both ENABLE_DEV_LOGIN=true and SUPABASE_SERVICE_ROLE_KEY must be set for
# the route to activate — the explicit flag means a service-role key
# accidentally left set in a preview/staging environment isn't enough on
# its own. Find the service-role key under Project Settings → API →
# service_role key.
ENABLE_DEV_LOGIN=
SUPABASE_SERVICE_ROLE_KEY=

# Sentry — error tracking and performance monitoring (Web Vitals are reported
# automatically via Sentry's browser tracing once this is set). The DSN is a
# write-only ingest key, not a secret, hence NEXT_PUBLIC_; it's reused
# server-side too (see instrumentation.ts / sentry.*.config.ts). Leaving it
# unset disables Sentry entirely (local dev default) rather than erroring.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: overrides NODE_ENV as the Sentry "environment" tag (e.g. "staging").
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional: fraction (0-1) of pageloads/navigations/server requests traced for
# performance data. Unset, blank or invalid means 1 (trace everything); lower it
# when ingest volume or cost becomes a concern.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Optional, CI/build only — enables source map upload to Sentry so stack
# traces resolve to original TypeScript. SENTRY_AUTH_TOKEN is a secret;
# without all three, the build silently skips the upload step.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Contact form (/api/contact) — emails the submitted message through Resend.
# RESEND_API_KEY is SERVER-SIDE ONLY (never NEXT_PUBLIC_). Without it the route
# answers 500. CONTACT_EMAIL_FROM must be on a domain verified in Resend
# (defaults to Resend's shared test sender); CONTACT_EMAIL_TO defaults to
# adrien.miquel.pro@gmail.com.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=
CONTACT_EMAIL_TO=
