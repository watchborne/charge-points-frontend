{
  "name": "charge-points-frontend",
  "version": "0.1.0",
  "private": true,
  "//dependencies-note": "TEMP (issue #415): @watchborne/charge-points-types below is pinned to the unreleased claude/415-remote-diagnostics-types branch (GetLog/GetDiagnostics/LogUpload) — revert to a pinned npm semver range once that package is released (see its CLAUDE.md 'Releasing' section) and bump this dependency here via the normal Dependabot flow.",
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npx tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run",
    "prepare": "husky",
    "all-checks": "bash scripts/all-checks.sh"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write",
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
