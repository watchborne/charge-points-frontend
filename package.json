    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.0",
    "prettier": "^3.8.4",
    "tailwindcss": "^3.4.0",
